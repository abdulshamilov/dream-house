# Настройки для голландского прокси-сервера

# ====== API КЛЮЧИ (хранятся ТОЛЬКО здесь!) ======
OPENAI_API_KEY=sk-...your-openai-key...
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...

# Секретный ключ для авторизации запросов с основного сервера
# Сгенерируйте: openssl rand -hex 32
PROXY_SECRET_KEY=сгенерируйте-случайный-ключ-32-символа

# ====== КЕШИРОВАНИЕ ======
# Включить кеширование повторных запросов (экономия денег!)
CACHE_ENABLED=true
# Время жизни кеша в секундах (1 час)
CACHE_TTL=3600

# ====== СЕРВЕР ======
PORT=8080
DEBUG=false
